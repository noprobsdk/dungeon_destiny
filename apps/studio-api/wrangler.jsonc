// FR-00003: the studio-api Worker (DD-017, DD-020). Terraform creates the
// Worker without a workers.dev address; it is reached only through the
// service binding from studio-web. Wrangler uploads its code versions.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "studio-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-07",
  "env": {
    "dev": {
      "name": "dd-dev-studio-api",
      // Must match Terraform: subdomain.enabled = false, previews_enabled = false.
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "dev",
        // Set at deploy time from the owner's private credential file with
        // --var; the deploy refuses to run without it. Empty lets nobody in.
        "SUPERADMIN_EMAIL": "",
        // FR-00004: also set at deploy time from the credential file, because
        // the account ID is kept out of the repository.
        "CF_ACCOUNT_ID": "",
        // FR-00004: Cloudflare's API, and the Access group "Content Studio
        // users" that studio-api keeps in step with the active users. The
        // group ID is not a secret; it comes from Terraform's output.
        "CF_API_BASE": "https://api.cloudflare.com/client/v4",
        "ACCESS_GROUP_ID": "3f332e12-c0d3-4cfd-9b09-93a49dfbe2b2"
      },
      // FR-00004 (DD-021): the Cloudflare API token for the Access group,
      // stored only as a Worker secret with `wrangler secret put`. A deploy
      // fails without it.
      "secrets": {
        "required": ["CF_ACCESS_GROUP_TOKEN"]
      },
      // FR-00004: Content D1, bound only to studio-api (DD-017, DD-020). The
      // database ID is not a secret; it comes from Terraform's output.
      "d1_databases": [
        {
          "binding": "CONTENT_D1",
          "database_name": "dd-dev-content",
          "database_id": "922c553e-8ccf-45e1-a98d-f0096a0be394",
          "migrations_dir": "migrations"
        }
      ],
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      }
    }
  }
}
